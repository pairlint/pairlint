{
  "$schema": "./node_modules/pairlint/schema.json",
  // Found 13 color tokens in 1 file.
  // 2 modes, named after the themes in your file names and selectors.
  "modes": {
    "light": "theme.css",
    "dark": ["theme.css", "theme.css#[data-theme=\"dark\"]"]
  },
  // Translucent backgrounds in dark modes sit on the page background, not on white.
  "base": { "dark": "{surface}" },
  // Also has colors, but does not look like a theme: brands.css#.acme
  // Also has colors, but does not look like a theme: brands.css#.zen
  // Pairs inferred from token names. Check that each one is a real combination in your UI.
  // Text and borders are paired with their own component's backgrounds, or else the shared
  // surfaces. Different intents and states are kept apart. About 6 pairs per mode.
  // Not paired, so not checked: on-brand. Add pairs for any your UI uses.
  "pairs": [
    { "fg": "text*", "bg": "surface*" },
    { "fg": "border", "bg": "surface*", "use": "ui" }
  ]
}
