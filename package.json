{
  "name": "pairlint-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/tokens-core",
    "packages/contrast",
    "packages/cli",
    "packages/figma-plugin"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p packages/figma-plugin/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:dist": "node scripts/check-dist.mjs",
    "check:size": "node scripts/check-size.mjs",
    "ci": "npm run lint && npm run build && npm run typecheck && npm test && npm run check:dist && npm run check:size"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@figma/plugin-typings": "1.142.0",
    "@types/culori": "4.0.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "culori": "4.0.2",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
